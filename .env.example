# ---- Discord ----
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id
GUILD_ID=your-server-id

# ---- Database (Railway Postgres) ----
# On Railway, set this to a reference variable: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:port/dbname

# ---- Server-specific role/channel IDs ----
AUDIT_CHANNEL_ID=your-audit-channel-id

# ---- AI verification (Gemini) ----
# Get a free key at https://aistudio.google.com/apikey — no credit card
# required. Required: without it, thank-yous will never be rewarded (see
# src/aiVerifier.js — that's a deliberate fail-safe, not a bug).
GEMINI_API_KEY=your-gemini-api-key
# Override if you want a different free-tier model.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=8000
GEMINI_CONTEXT_MESSAGE_COUNT=4

# ---- Reward tuning (all optional, defaults shown) ----
# Every AI-verified genuine-help thank-you now earns the same amount —
# there is no more OG/non-OG split or Engage Points path.
ACTION_POINTS_PER_REWARD=1000
HELPER_DAILY_LIMIT=15
THANKER_DAILY_LIMIT=15
HELP_WINDOW_HOURS=24
HEARTBEAT_INTERVAL_MS=30000

# Set to "true" to force SSL on the DB connection (usually not needed on Railway's
# internal network, but required if you connect via the public DB proxy URL).
DATABASE_SSL=false
